/*
 * Reference bpftrace program for MEMO-Appflow Android collection.
 *
 * The Python orchestrator normally generates a target-specific version after
 * probing /sys/kernel/tracing/available_events. Keep this file as the readable
 * contract for raw TSV output:
 *
 * MEMO ts_ns event_type uid pid tid comm arg0 arg1 arg2 arg3 detail
 */

tracepoint:binder:binder_transaction
{
  printf("MEMO\t%llu\tbinder\t0\t%d\t0\t-\t%d\t%d\t0\t0\t-\n",
    nsecs, pid, args->code, args->flags);
}

tracepoint:syscalls:sys_enter_openat
{
  printf("MEMO\t%llu\tfile\t0\t%d\t0\t-\t0\t0\t0\t0\topenat\n",
    nsecs, pid);
}

tracepoint:vmscan:mm_vmscan_direct_reclaim_begin
{
  printf("MEMO\t%llu\tmemory\t0\t%d\t0\t-\t1\t0\t0\t0\tdirect_reclaim_begin\n",
    nsecs, pid);
}

tracepoint:vmscan:mm_vmscan_direct_reclaim_end
{
  printf("MEMO\t%llu\tmemory\t0\t%d\t0\t-\t2\t0\t0\t0\tdirect_reclaim_end\n",
    nsecs, pid);
}

tracepoint:vmscan:mm_vmscan_kswapd_wake
{
  printf("MEMO\t%llu\tmemory\t0\t%d\t0\t-\t3\t0\t0\t0\tkswapd_wake\n",
    nsecs, pid);
}

tracepoint:sched:sched_process_fork
{
  printf("MEMO\t%llu\tprocess_fork\t0\t%d\t0\t-\t%d\t%d\t0\t0\tfork\n",
    nsecs, pid, args->parent_pid, args->child_pid);
}

tracepoint:sched:sched_process_exit
{
  printf("MEMO\t%llu\tprocess_exit\t0\t%d\t0\t-\t0\t0\t0\t0\texit\n",
    nsecs, pid);
}

tracepoint:syscalls:sys_enter_sendto
{
  printf("MEMO\t%llu\tnetwork\t0\t%d\t0\t-\t1\t%d\t0\t0\tsend\n",
    nsecs, pid, args->len);
}

tracepoint:syscalls:sys_enter_recvfrom
{
  printf("MEMO\t%llu\tnetwork\t0\t%d\t0\t-\t2\t%d\t0\t0\trecv\n",
    nsecs, pid, args->size);
}

tracepoint:sched:sched_switch
{
  printf("MEMO\t%llu\tsched\t0\t%d\t0\t-\t%d\t%d\t0\t0\tswitch\n",
    nsecs, pid, args->prev_pid, args->next_pid);
}

tracepoint:sched:sched_wakeup
{
  printf("MEMO\t%llu\tsched\t0\t%d\t0\t-\t%d\t%d\t0\t0\twakeup\n",
    nsecs, pid, args->pid, args->prio);
}

kprobe:input_event
{
  printf("MEMO\t%llu\tinput\t0\t%d\t0\t-\t0\t0\t0\t0\tinput_event\n",
    nsecs, pid);
}
